@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(OpenGL)
find_dependency(PNG)
find_dependency(ZLIB)
find_dependency(SDL2)
find_dependency(Vulkan)
find_dependency(box2d CONFIG)
find_dependency(sol2 CONFIG)

if("@SIMLIB_TTF_TARGET@" STREQUAL "SDL2_ttf::SDL2_ttf")
    find_dependency(SDL2_ttf CONFIG)
    if(NOT TARGET SDL2_ttf::SDL2_ttf AND TARGET SDL2_ttf::SDL2_ttf-static)
        add_library(SDL2_ttf::SDL2_ttf INTERFACE IMPORTED GLOBAL)
        set_property(TARGET SDL2_ttf::SDL2_ttf PROPERTY INTERFACE_LINK_LIBRARIES SDL2_ttf::SDL2_ttf-static)
    endif()
elseif("@SIMLIB_TTF_TARGET@" STREQUAL "SDL2_ttf::SDL2_ttf-static")
    find_dependency(SDL2_ttf CONFIG)
    if(NOT TARGET SDL2_ttf::SDL2_ttf-static AND TARGET SDL2_ttf::SDL2_ttf)
        add_library(SDL2_ttf::SDL2_ttf-static INTERFACE IMPORTED GLOBAL)
        set_property(TARGET SDL2_ttf::SDL2_ttf-static PROPERTY INTERFACE_LINK_LIBRARIES SDL2_ttf::SDL2_ttf)
    endif()
else()
    find_dependency(PkgConfig)
    pkg_check_modules(SDL2_TTF REQUIRED IMPORTED_TARGET SDL2_ttf)
endif()

if("@SIMLIB_IMAGE_TARGET@" STREQUAL "SDL2_image::SDL2_image")
    find_dependency(SDL2_image CONFIG)
    if(NOT TARGET SDL2_image::SDL2_image AND TARGET SDL2_image::SDL2_image-static)
        add_library(SDL2_image::SDL2_image INTERFACE IMPORTED GLOBAL)
        set_property(TARGET SDL2_image::SDL2_image PROPERTY INTERFACE_LINK_LIBRARIES SDL2_image::SDL2_image-static)
    endif()
elseif("@SIMLIB_IMAGE_TARGET@" STREQUAL "SDL2_image::SDL2_image-static")
    find_dependency(SDL2_image CONFIG)
    if(NOT TARGET SDL2_image::SDL2_image-static AND TARGET SDL2_image::SDL2_image)
        add_library(SDL2_image::SDL2_image-static INTERFACE IMPORTED GLOBAL)
        set_property(TARGET SDL2_image::SDL2_image-static PROPERTY INTERFACE_LINK_LIBRARIES SDL2_image::SDL2_image)
    endif()
else()
    find_dependency(PkgConfig)
    pkg_check_modules(SDL2_IMAGE REQUIRED IMPORTED_TARGET SDL2_image)
endif()

if("@SIMLIB_MIXER_TARGET@" STREQUAL "SDL2_mixer::SDL2_mixer")
    find_dependency(SDL2_mixer CONFIG)
    if(NOT TARGET SDL2_mixer::SDL2_mixer AND TARGET SDL2_mixer::SDL2_mixer-static)
        add_library(SDL2_mixer::SDL2_mixer INTERFACE IMPORTED GLOBAL)
        set_property(TARGET SDL2_mixer::SDL2_mixer PROPERTY INTERFACE_LINK_LIBRARIES SDL2_mixer::SDL2_mixer-static)
    endif()
elseif("@SIMLIB_MIXER_TARGET@" STREQUAL "SDL2_mixer::SDL2_mixer-static")
    find_dependency(SDL2_mixer CONFIG)
    if(NOT TARGET SDL2_mixer::SDL2_mixer-static AND TARGET SDL2_mixer::SDL2_mixer)
        add_library(SDL2_mixer::SDL2_mixer-static INTERFACE IMPORTED GLOBAL)
        set_property(TARGET SDL2_mixer::SDL2_mixer-static PROPERTY INTERFACE_LINK_LIBRARIES SDL2_mixer::SDL2_mixer)
    endif()
else()
    find_dependency(PkgConfig)
    pkg_check_modules(SDL2_MIXER REQUIRED IMPORTED_TARGET SDL2_mixer)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/simlibTargets.cmake")
check_required_components(simlib)