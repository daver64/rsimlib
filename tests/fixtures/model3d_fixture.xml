<?xml version="1.0"?>
<PropertyList>
    <path>model3d_fixture.ac</path>
    <animation>
        <type>rotate</type>
        <object-name>fuselage</object-name>
        <property>controls/aileron</property>
        <factor>45</factor>
        <axis><x>0</x><y>1</y><z>0</z></axis>
    </animation>
    <animation>
        <type>translate</type>
        <object-name>fuselage</object-name>
        <property>gear/extension</property>
        <offset-m>0.1</offset-m>
        <axis><x>1</x><y>0</y><z>0</z></axis>
    </animation>
    <animation>
        <type>translate</type>
        <object-name>BeaconOffX</object-name>
        <offset-m>5</offset-m>
        <axis><x>3</x><y>0</y><z>4</z></axis>
    </animation>
    <animation>
        <type>spin</type>
        <object-name>Propeller</object-name>
        <property>/params/engine/rpm</property>
        <factor>-1</factor>
        <axis><x>1</x><y>0</y><z>0</z></axis>
    </animation>
    <animation>
        <type>blend</type>
        <object-name>Propeller.Fast</object-name>
        <property>/params/engine/rpm</property>
        <factor>0.0004</factor>
        <min>0</min>
        <max>0.5</max>
    </animation>
    <animation>
        <type>select</type>
        <object-name>Propeller.Fast</object-name>
        <condition>
            <and>
                <greater-than>
                    <property alias="/params/engine/rpm"/>
                    <value>400</value>
                </greater-than>
                <not><property>/params/engine/crashed</property></not>
            </and>
        </condition>
    </animation>
    <animation>
        <type>pick</type>
        <object-name>fuselage</object-name>
    </animation>
</PropertyList>
